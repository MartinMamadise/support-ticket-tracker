# Copy to .env (git-ignored) and fill in. Used by docker compose and, as plain environment variables, by a locally
# started backend. Do NOT commit real values.

# --- Database ---
DB_USERNAME=supporthub
DB_PASSWORD=change-me-db-password
# Docker only: MySQL root password for the db container
MYSQL_ROOT_PASSWORD=change-me-root-password
# Optional - defaults shown
DB_HOST=localhost
DB_PORT=3306
DB_NAME=support_ticket_tracker

# Optional - "dev" enables the OpenAPI document and Swagger UI and allows http://localhost:4200; leave unset in production
SPRING_PROFILES_ACTIVE=

# Optional - set to true ONCE to adopt a database created before Flyway was introduced (see README)
FLYWAY_BASELINE_ON_MIGRATE=false

# --- Authentication ---
# Session and CSRF cookies are Secure by default. Only for local development over plain http: false
# (the "dev" profile and docker-compose already do this).
SESSION_COOKIE_SECURE=true
# Comma separated browser origins allowed to call the API with cookies. Leave empty for same-origin deployments.
CORS_ALLOWED_ORIGINS=
# First start only: create the very first account (only if no account exists). Remove these afterwards.
BOOTSTRAP_USER_ENABLED=true
BOOTSTRAP_USER_USERNAME=admin
BOOTSTRAP_USER_EMAIL=admin@example.com
BOOTSTRAP_USER_PASSWORD=change-me-Admin-123
# Role of that first account: ADMIN (default), SUPPORT_AGENT or USER
BOOTSTRAP_USER_ROLE=ADMIN

# --- Attachments ---
# Directory for uploaded files (outside any web root). Docker uses a volume at /data/attachments.
ATTACHMENTS_DIR=./data/attachments

# --- SLA monitor (approaching/breached deadline notifications) ---
SLA_MONITOR_ENABLED=true
