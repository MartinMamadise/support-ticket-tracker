{
  "name": "supporthub-frontend",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:ci": "ng test --watch=false",
    "lint": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.spec.json --noEmit && tsc -p e2e/tsconfig.json && prettier --check \"src/**/*.{ts,html,css}\" \"e2e/**/*.ts\"",
    "format": "prettier --write \"src/**/*.{ts,html,css}\" \"e2e/**/*.ts\"",
    "e2e": "playwright test -c e2e/playwright.config.ts"
  },
  "private": true,
  "packageManager": "npm@10.9.9",
  "dependencies": {
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/router": "^22.2.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.8",
    "@angular/cli": "^22.2.8",
    "@angular/compiler-cli": "^22.2.0",
    "@playwright/test": "^1.65.1",
    "@types/node": "^22.20.5",
    "jsdom": "^30.0.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "vitest": "^5.0.0"
  }
}
